<Project Sdk="Microsoft.NET.Sdk">
  <!-- The prefetch module's managed component: the entry OmsiLaunch's bridge
       loads inside OMSI. The contracts come from the bridge, so they are not
       copied next to it. -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Prefetch.Module</AssemblyName>
    <RootNamespace>OmsiLaunch.Modules.Prefetch</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(OmsiLaunchRoot)src\OmsiLaunch.Runtime.Modules\OmsiLaunch.Runtime.Modules.csproj" Private="false" />
    <ProjectReference Include="$(OmsiLaunchRoot)src\OmsiLaunch.Api\OmsiLaunch.Api.csproj" Private="false" />
  </ItemGroup>
</Project>
